rules_version = '2';
// ปิดทุกอย่างสำหรับเบราว์เซอร์/แอปไคลเอนต์ ข้อมูลทั้งหมดอ่านเขียนผ่านเซิร์ฟเวอร์ (Admin SDK) เท่านั้น
// Admin SDK ข้ามกฎนี้ได้ จึงแก้ paidUntil หรือยอดเงินจากเบราว์เซอร์ไม่ได้
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
